# ─────────────────────────────────────────────────────────────
# MAPA DE FLUJOS · Explorador de flujos (IA)
# Copia este archivo como .env. Las claves SOLO se leen en el servidor:
# nunca llegan al navegador, ni a localStorage, ni a IndexedDB.
# Sin clave, el Explorador funciona en MODO DEMOSTRACIÓN (sin IA, identificado).
# ─────────────────────────────────────────────────────────────

# Proveedor: gemini | openai | anthropic | demo   (si se omite, se elige según la clave disponible)
EXPLORER_PROVIDER=gemini

# ── Google Gemini (SDK oficial @google/genai) ──
GEMINI_API_KEY=
# Modelo. Si se deja vacío se descubre automáticamente el modelo «flash» vigente.
GEMINI_MODEL=

# ── Cualquier API compatible con OpenAI (OpenAI, Mistral, Groq, OpenRouter, DeepSeek, Ollama, LM Studio…) ──
# EXPLORER_PROVIDER=openai
# OPENAI_API_KEY=
# EXPLORER_BASE_URL=https://api.openai.com/v1     # p.ej. http://localhost:11434/v1 para Ollama
# OPENAI_MODEL=                                     # si se omite se toma de /models
# EXPLORER_TRANSCRIBE_MODEL=whisper-1               # transcripción de notas de voz

# ── Anthropic Claude ──
# EXPLORER_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=                                  # si se omite se descubre en /v1/models

# Clave genérica alternativa (se aplica al proveedor elegido) y modelo genérico
# EXPLORER_API_KEY=
# EXPLORER_MODEL=

# Peticiones por minuto y por IP al servidor del Explorador
EXPLORER_RATE_LIMIT=40
# Puerto del servidor independiente (npm start)
PORT=4321

{
  "name": "mapa-de-flujos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MAPA DE FLUJOS — editor de mapas mentales con motor de flujos, circuitos y simulación",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "start": "node server/standalone.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.32.0",
    "@xyflow/react": "^12.12.0",
    "dexie": "^4.4.7",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.66.0",
    "mammoth": "^1.13.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "marked": "^15.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
